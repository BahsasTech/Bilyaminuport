# Admin
# Password used at /admin/login. Required in production.
ADMIN_PASSWORD=change-me-to-a-strong-password
# Long random string used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Storage
# Required in production on Vercel. Create a Blob store in the Vercel dashboard.
# Leave blank locally to use the .data/ and public/uploads/ fallback.
BLOB_READ_WRITE_TOKEN=

# Public site URL used for SEO metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://bahsastech.vercel.app
